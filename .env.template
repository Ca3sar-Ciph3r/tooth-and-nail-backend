# Copy this file to .env and fill in the values

# ── Database (Neon) ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ── Security (generate random strings — keep secret!) ───────────────────────
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
COOKIE_SECRET=your-super-secret-cookie-key-min-32-chars

# ── CORS (comma-separated allowed origins) ───────────────────────────────────
STORE_CORS=http://localhost:3000,https://toothandnail-v2-7aft.vercel.app
ADMIN_CORS=http://localhost:9000,http://localhost:7001
AUTH_CORS=http://localhost:3000,http://localhost:9000,http://localhost:7001,https://toothandnail-v2-7aft.vercel.app

# ── Backend URL (set to your Render URL after deploy) ────────────────────────
MEDUSA_BACKEND_URL=http://localhost:9000